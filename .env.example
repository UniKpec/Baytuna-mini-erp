GITHUB_OWNER=unikpec
POSTGRES_B_PASSWORD=change_me

# JWT sozlesmesi - iki servis de ayni degeri okur, farkli olursa dogrulama patlar.
# Uretmek icin: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me
JWT_ISSUER=MiniErp.ServiceA
JWT_AUDIENCE=MiniErp.ServiceB

# Servis A - frontend'in adresleri (virgulle ayrilir)
CORS_ORIGINS=http://localhost:3000

# Servis A - kritik stok maili (hicbiri ayarli degilse mail atlanir, akis bozulmaz)
# Once Resend denenir, o yoksa SMTP'ye duser.
RESEND_API_KEY=
# Domain dogrulanana kadar onboarding@resend.dev; sadece kendi hesap adresine gonderir.
RESEND_FROM=onboarding@resend.dev

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=mini-erp@ornek.com
